# ---- Razorpay (required for real online payments) ----
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# ---- Admin account (required — no default password is shipped) ----
# Set a plain password here ONLY for the very first server start;
# the server hashes it with bcrypt and stores the hash in data/db.json,
# then you should remove this value from your real .env file.
ADMIN_USERNAME="admin"
ADMIN_BOOTSTRAP_PASSWORD="change-this-before-first-run"

# ---- Server ----
NODE_ENV="production"
